# Copy to .env before `alchemy deploy --env-file .env`. Never commit .env.

# Encrypts secret bindings inside Alchemy's state files. Pick once, keep
# stable forever (changing it orphans existing encrypted state).
ALCHEMY_PASSWORD=

# Session cookie sealing key. Any long random string.
SESSION_SECRET=

# The public URL the deployed app answers on, e.g.
# https://travel2-prod.<your-subdomain>.workers.dev
APP_URL=

# Cloudflare auth for deploys without an interactive `wrangler login`:
# dash.cloudflare.com -> profile -> API Tokens -> "Edit Cloudflare Workers"
# template. Either this token or a prior `wrangler login` works.
CLOUDFLARE_API_TOKEN=

# External place providers for /api/places (each optional; the aggregator
# uses whichever keys exist and skips the rest).
YELP_API_KEY=
FOURSQUARE_API_KEY=
GOOGLE_PLACES_API_KEY=
TRIPADVISOR_API_KEY=
